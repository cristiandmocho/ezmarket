{
  "name": "ezmarkets",
  "version": "0.17.1",
  "description": "Supermarket product scraper and price comparison engine",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "build:css": "sass src/scss/main.scss src/public/css/main.css --style=compressed --no-source-map",
    "watch:css": "sass --watch --no-source-map src/scss/main.scss:src/public/css/main.css",
    "db:init": "node src/db/init.js",
    "db:migrate": "node src/db/migrate-canonical.js",
    "scrape": "node src/index.js",
    "match": "node --env-file=.env src/jobs/matchProducts.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "Cristian Mocho",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-openid-connect": "^2.20.2",
    "lru-cache": "^11.3.6",
    "mysql2": "^3.22.3",
    "playwright": "^1.59.1",
    "sass": "^1.99.0"
  }
}
