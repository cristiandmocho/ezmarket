<div class="login">
  <div class="login__inner">
    <h1 class="login__heading">Aceder à conta</h1>
    <p class="login__sub">Gerencie as finanças da sua casa com tranquilidade.</p>

    <form class="login__form" action="/login" method="post">
      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input
          class="field__input"
          id="email"
          name="email"
          type="email"
          placeholder="nome@exemplo.com"
          autocomplete="email"
          required
        >
      </div>

      <div class="field login__password-field">
        <div class="login__password-header">
          <label class="field__label" for="password">Palavra-passe</label>
          <a class="login__forgot" href="/auth/login?screen_hint=forgotPassword">Esqueceu-se da palavra-passe?</a>
        </div>
        <div class="login__password-wrap">
          <input
            class="field__input login__password-input"
            id="password"
            name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
          >
          <button type="button" class="login__eye" aria-label="Mostrar palavra-passe" data-target="password">
            <span class="mdi">visibility</span>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn--primary login__submit">Entrar</button>
    </form>

    <div class="login__divider"><span>Ou continuar com</span></div>

    <div class="login__social-group">
      <a href="/login/google" class="login__social btn btn--ghost">
        <svg class="login__provider-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Google
      </a>

      <a href="/login/microsoft" class="login__social btn btn--ghost">
        <svg class="login__provider-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M11.4 2H2v9.4h9.4V2z" fill="#F25022"/>
          <path d="M22 2h-9.4v9.4H22V2z" fill="#7FBA00"/>
          <path d="M11.4 12.6H2V22h9.4v-9.4z" fill="#00A4EF"/>
          <path d="M22 12.6h-9.4V22H22v-9.4z" fill="#FFB900"/>
        </svg>
        Microsoft
      </a>
    </div>

    <p class="login__footer">
      Não tem uma conta?
      <a href="/auth/login?screen_hint=signup" class="login__signup-link">Criar conta</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('.login__eye').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      const icon = btn.querySelector('.mdi');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
        btn.setAttribute('aria-label', 'Ocultar palavra-passe');
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
        btn.setAttribute('aria-label', 'Mostrar palavra-passe');
      }
    });
  });
</script>
