<% if (locals.backNav) { %>
<header class="nav">
  <a href="<%= backNav.href %>" class="icon-btn" aria-label="Voltar">
    <span class="mdi">arrow_back</span>
  </a>
  <span class="nav__title"><%= backNav.title %></span>
  <div class="nav__actions">
    <button class="icon-btn" aria-label="Partilhar">
      <span class="mdi">share</span>
    </button>
    <% if (backNav.listId) { %>
    <button class="icon-btn" id="btn-rename" aria-label="Editar nome"
            data-rename-id="<%= backNav.listId %>"
            data-rename-name="<%= backNav.title %>">
      <span class="mdi">edit</span>
    </button>
    <% } else { %>
    <button class="icon-btn" aria-label="Editar">
      <span class="mdi">edit</span>
    </button>
    <% } %>
  </div>
</header>
<% } else { %>
<header class="nav">
  <button class="icon-btn" aria-label="Abrir menu">
    <span class="mdi">menu</span>
  </button>

  <a href="/" class="nav__brand">Quanto Fica?</a>

  <div class="nav__actions">
    <% if (locals.user) { %>
    <a href="/logout" class="icon-btn" aria-label="Terminar sessão">
      <span class="mdi">logout</span>
    </a>
    <% } else { %>
    <a href="/login" class="nav__login">Login</a>
    <% } %>
    <button class="icon-btn" aria-label="Definições de filtros">
      <span class="mdi">tune</span>
    </button>
  </div>
</header>
<% } %>
